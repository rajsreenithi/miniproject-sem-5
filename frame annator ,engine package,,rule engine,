"""OpenCV drawing helpers for the AuraVision vision engine."""

from typing import Mapping, Sequence

import cv2
import numpy as np
from numpy.typing import NDArray

from engine.tracker import Point, Track
from engine.zones import Polygon


Image = NDArray[np.uint8]
Line = tuple[Point, Point]


class FrameAnnotator:
    """Draw people, zone boundaries, counts, and a counting line."""

    def __init__(self, thickness: int = 2) -> None:
        """Initialize drawing settings."""
        if thickness <= 0:
            raise ValueError("thickness must be positive")

        self.thickness = thickness

    def annotate(
        self,
        frame: Image,
        tracks: Sequence[Track],
        zones: Mapping[int, Polygon] | None = None,
        counts: Mapping[int, int] | None = None,
        line: Line | None = None,
    ) -> Image:
        """Return an annotated copy of a BGR frame."""
        if frame is None or frame.size == 0:
            raise ValueError("frame must not be empty")

        output = frame.copy()
        counts = counts or {}
        zones = zones or {}

        for track in tracks:
            x1, y1, x2, y2 = track.bbox

            cv2.rectangle(
                output,
                (x1, y1),
                (x2, y2),
                (0, 220, 0),
                self.thickness,
            )

            label = (
                f"ID {track.track_id} "
                f"{track.confidence:.2f}"
            )

            cv2.putText(
                output,
                label,
                (x1, max(20, y1 - 8)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.55,
                (0, 220, 0),
                self.thickness,
                cv2.LINE_AA,
            )

            foot_x = int(round(track.foot_point[0]))
            foot_y = int(round(track.foot_point[1]))

            cv2.circle(
                output,
                (foot_x, foot_y),
                4,
                (0, 0, 255),
                -1,
            )

        for zone_id, polygon in zones.items():
            points = np.array(
                [
                    [int(round(x)), int(round(y))]
                    for x, y in polygon
                ],
                dtype=np.int32,
            ).reshape((-1, 1, 2))

            cv2.polylines(
                output,
                [points],
                True,
                (255, 180, 0),
                self.thickness,
            )

            anchor_x, anchor_y = points[0, 0]

            cv2.putText(
                output,
                f"Zone {zone_id}: {counts.get(zone_id, 0)}",
                (int(anchor_x), max(20, int(anchor_y) - 8)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (255, 180, 0),
                self.thickness,
                cv2.LINE_AA,
            )

        if line is not None:
            start, end = line

            cv2.line(
                output,
                (int(round(start[0])), int(round(start[1]))),
                (int(round(end[0])), int(round(end[1]))),
                (0, 0, 255),
                self.thickness,
            )

        return output


def annotate_frame(
    frame: Image,
    tracks: Sequence[Track],
    zones: Mapping[int, Polygon] | None = None,
    counts: Mapping[int, int] | None = None,
    line: Line | None = None,
) -> Image:
    """Convenience function for annotating a single frame."""
    annotator = FrameAnnotator()
    return annotator.annotate(
        frame=frame,
        tracks=tracks,
        zones=zones,
        counts=counts,
        line=line,
    )
