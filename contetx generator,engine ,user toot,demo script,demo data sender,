"""Idempotently seed a demo camera, zone, counting line, and site-specific rule."""
from __future__ import annotations

import argparse
from pathlib import Path

from db.connection import get_connection

# Edit these image-pixel coordinates to match your video resolution/scene.
ZONE_NAME = "Demo Zone"
ZONE_POINTS = [
    (250, 150),
    (950, 150),
    (950, 650),
    (250, 650),
]
LINE_NAME = "Demo Entry Line"
COUNT_LINE = (600, 150, 600, 650)  # x1, y1, x2, y2
FLOOR_LABEL = "Ground"

SITE_CONFIG = {
    "retail": {
        "site_name": "Demo Retail Store",
        "site_type": "retail",
        "camera_name": "Demo Camera",
        "rule_type": "occupancy_limit",
        "min_people": 2,
        "min_duration_sec": 30,
        "clear_after_sec": 60,
        "cooldown_sec": 600,
    },
    "water_point": {
        "site_name": "College Water Point",
        "site_type": "water_point",
        "camera_name": "College Water Point Camera",
        "rule_type": "restricted_presence",
        "min_people": 2,
        "min_duration_sec": 30,
        "clear_after_sec": 60,
        "cooldown_sec": 600,
    },
}

ALL_DAY_START = "00:00:00"
ALL_DAY_END = "23:59:59"


def _ensure_rule(cur, site_id: int, config: dict) -> None:
    """Create the site's demo rule if missing; ensure it is active."""
    cur.execute(
        """SELECT rule_id
           FROM rules
           WHERE site_id = %s AND rule_type = %s
           ORDER BY rule_id
           LIMIT 1""",
        (site_id, config["rule_type"]),
    )
    rule = cur.fetchone()

    if rule is None:
        cur.execute(
            """INSERT INTO rules
               (site_id, rule_type, min_people, min_duration_sec,
                clear_after_sec, cooldown_sec, is_active)
               VALUES (%s, %s, %s, %s, %s, %s, %s)""",
            (
                site_id,
                config["rule_type"],
                config["min_people"],
                config["min_duration_sec"],
                config["clear_after_sec"],
                config["cooldown_sec"],
                True,
            ),
        )
    else:
        cur.execute(
            "UPDATE rules SET is_active = %s WHERE rule_id = %s",
            (True, int(rule["rule_id"])),
        )


def _ensure_all_day_class_slots(cur, site_id: int) -> None:
    """Ensure a class slot covers the whole day for each weekday (Monday=1)."""
    for day_of_week in range(1, 8):
        cur.execute(
            """SELECT slot_id
               FROM schedule_slots
               WHERE site_id = %s
                 AND day_of_week = %s
                 AND start_time = %s
                 AND end_time = %s
                 AND slot_type = %s
               LIMIT 1""",
            (
                site_id,
                day_of_week,
                ALL_DAY_START,
                ALL_DAY_END,
                "class",
            ),
        )
        if cur.fetchone() is None:
            cur.execute(
                """INSERT INTO schedule_slots
                   (site_id, day_of_week, start_time, end_time, slot_type)
                   VALUES (%s, %s, %s, %s, %s)""",
                (
                    site_id,
                    day_of_week,
                    ALL_DAY_START,
                    ALL_DAY_END,
                    "class",
                ),
            )


def seed(video_uri: str, site: str = "retail") -> int:
    """Create missing demo records and return the camera_id.

    Existing matching site, camera, zone, line, and rule records are reused.
    The water_point profile also gets an active restricted-presence rule and
    an all-day class slot for every weekday.
    """
    if site not in SITE_CONFIG:
        raise ValueError(
            f"Unsupported site profile {site!r}. "
            f"Choose one of: {', '.join(SITE_CONFIG)}"
        )

    config = SITE_CONFIG[site]

    with get_connection() as conn:
        with conn.cursor() as cur:
            cur.execute(
                "SELECT site_id FROM sites WHERE name = %s LIMIT 1",
                (config["site_name"],),
            )
            site_row = cur.fetchone()

            if site_row is None:
                cur.execute(
                    "INSERT INTO sites (name, site_type) VALUES (%s, %s)",
                    (config["site_name"], config["site_type"]),
                )
                site_id = int(cur.lastrowid)
            else:
                site_id = int(site_row["site_id"])
                # Keep the site's type aligned with the selected profile.
                cur.execute(
                    "UPDATE sites SET site_type = %s WHERE site_id = %s",
                    (config["site_type"], site_id),
                )

            cur.execute(
                """SELECT camera_id
                   FROM cameras
                   WHERE site_id = %s
                     AND name = %s
                     AND source_type = %s
                     AND source_uri = %s
                   LIMIT 1""",
                (site_id, config["camera_name"], "file", video_uri),
            )
            camera = cur.fetchone()

            if camera is None:
                cur.execute(
                    """INSERT INTO cameras
                       (site_id, name, floor_label, source_type, source_uri,
                        frame_stride, is_active)
                       VALUES (%s, %s, %s, %s, %s, %s, %s)""",
                    (
                        site_id,
                        config["camera_name"],
                        FLOOR_LABEL,
                        "file",
                        video_uri,
                        2,
                        True,
                    ),
                )
                camera_id = int(cur.lastrowid)
            else:
                camera_id = int(camera["camera_id"])

            cur.execute(
                "SELECT zone_id FROM zones WHERE camera_id = %s AND name = %s LIMIT 1",
                (camera_id, ZONE_NAME),
            )
            zone = cur.fetchone()

            if zone is None:
                cur.execute(
                    "INSERT INTO zones (camera_id, name) VALUES (%s, %s)",
                    (camera_id, ZONE_NAME),
                )
                zone_id = int(cur.lastrowid)
            else:
                zone_id = int(zone["zone_id"])

            # Make reruns deterministic: replace this zone's vertices.
            cur.execute("DELETE FROM zone_points WHERE zone_id = %s", (zone_id,))
            cur.executemany(
                """INSERT INTO zone_points (zone_id, seq, x, y)
                   VALUES (%s, %s, %s, %s)""",
                [
                    (zone_id, seq, x, y)
                    for seq, (x, y) in enumerate(ZONE_POINTS, start=1)
                ],
            )

            cur.execute(
                "SELECT line_id FROM count_lines WHERE camera_id = %s AND name = %s LIMIT 1",
                (camera_id, LINE_NAME),
            )
            line = cur.fetchone()
            x1, y1, x2, y2 = COUNT_LINE

            if line is None:
                cur.execute(
                    """INSERT INTO count_lines
                       (camera_id, name, x1, y1, x2, y2)
                       VALUES (%s, %s, %s, %s, %s, %s)""",
                    (camera_id, LINE_NAME, x1, y1, x2, y2),
                )
            else:
                cur.execute(
                    """UPDATE count_lines
                       SET x1 = %s, y1 = %s, x2 = %s, y2 = %s
                       WHERE line_id = %s""",
                    (x1, y1, x2, y2, int(line["line_id"])),
                )

            _ensure_rule(cur, site_id, config)

            if site == "water_point":
                _ensure_all_day_class_slots(cur, site_id)

    return camera_id


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("video_uri", help="Video path, e.g. videos/test.mp4")
    parser.add_argument(
        "--site",
        choices=tuple(SITE_CONFIG),
        default="retail",
        help="Site profile to seed (default: retail)",
    )
    args = parser.parse_args()

    uri = str(Path(args.video_uri).expanduser().resolve())
    camera_id = seed(uri, site=args.site)

    print(f"Demo camera ready. site={args.site} camera_id={camera_id}")
    print(f"Video URI: {uri}")
    print("Review ZONE_POINTS and COUNT_LINE constants before running worker.py.")

    if args.site == "water_point":
        print("Created/reused the College Water Point restricted_presence rule.")
        print("Ensured all-day class slots exist for all seven days.")
        print("NOTE: the retail video is being used as a stand-in, not real water-point footage.")


if __name__ == "__main__":
    main()
