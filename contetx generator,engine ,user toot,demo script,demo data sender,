"""Send pending alerts to the HOD (Telegram or email) and record the outcome."""
import os
import smtplib
import ssl
import time
import urllib.parse
import urllib.request
from email.message import EmailMessage

import pymysql
from dotenv import load_dotenv

load_dotenv()

POLL_SECONDS = 10

QUERY = """
SELECT a.alert_id, r.channel, r.address, i.started_at, i.peak_count,
       c.name AS camera_name, c.floor_label, s.name AS site_name, s.site_type
FROM alerts a
JOIN recipients r ON r.recipient_id = a.recipient_id
JOIN incidents i ON i.incident_id = a.incident_id
JOIN cameras c ON c.camera_id = i.camera_id
JOIN sites s ON s.site_id = c.site_id
WHERE a.status = 'pending'
ORDER BY a.alert_id
LIMIT 20
"""


def connect():
    return pymysql.connect(
        host=os.getenv("DB_HOST", "localhost"),
        user=os.getenv("DB_USER"),
        password=os.getenv("DB_PASSWORD", ""),
        database=os.getenv("DB_NAME", "auravision"),
        cursorclass=pymysql.cursors.DictCursor,
        autocommit=True,
    )


def build_message(row):
    place = row["floor_label"] or row["camera_name"]
    when = row["started_at"].strftime("%d %b %Y, %H:%M:%S")
    if row["site_type"] == "water_point":
        return (f"AuraVision alert: people are gathered at the water point "
                f"({place}) during a restricted period.\n"
                f"Started: {when}\nPeak count: {row['peak_count']}")
    return (f"AuraVision alert: occupancy limit exceeded at {row['site_name']} "
            f"({place}).\nStarted: {when}\nPeak count: {row['peak_count']}")


def send_telegram(chat_id, text):
    token = os.getenv("TELEGRAM_BOT_TOKEN")
    if not token:
        raise RuntimeError("TELEGRAM_BOT_TOKEN missing in .env")
    url = f"https://api.telegram.org/bot{token}/sendMessage"
    data = urllib.parse.urlencode({"chat_id": chat_id, "text": text}).encode()
    with urllib.request.urlopen(urllib.request.Request(url, data=data), timeout=15) as resp:
        if resp.status != 200:
            raise RuntimeError(f"Telegram returned HTTP {resp.status}")


def send_email(address, text):
    host = os.getenv("SMTP_HOST")
    if not host:
        raise RuntimeError("SMTP_HOST missing in .env")
    port = int(os.getenv("SMTP_PORT", "587"))
    user = os.getenv("SMTP_USER")
    msg = EmailMessage()
    msg["Subject"] = "AuraVision alert"
    msg["From"] = os.getenv("SMTP_FROM", user)
    msg["To"] = address
    msg.set_content(text)
    with smtplib.SMTP(host, port, timeout=20) as smtp:
        smtp.starttls(context=ssl.create_default_context())
        smtp.login(user, os.getenv("SMTP_PASSWORD"))
        smtp.send_message(msg)


def deliver(row):
    text = build_message(row)
    if row["channel"] == "telegram":
        send_telegram(row["address"], text)
    elif row["channel"] == "email":
        send_email(row["address"], text)
    else:
        raise NotImplementedError("SMS delivery is not enabled (needs DLT registration)")


def run_once(conn):
    with conn.cursor() as cur:
        cur.execute(QUERY)
        rows = cur.fetchall()
        for row in rows:
            try:
                deliver(row)
                status, error = "sent", None
            except Exception as exc:  # one bad alert must not stop the loop
                status, error = "failed", str(exc)[:250]
            cur.execute(
                "UPDATE alerts SET status=%s, error_msg=%s, sent_at=NOW() WHERE alert_id=%s",
                (status, error, row["alert_id"]),
            )
            print(f"alert {row['alert_id']} -> {status} {error or ''}")


def main():
    conn = None
    print("Dispatcher running. Ctrl+C to stop.")
    while True:
        try:
            if conn is None:
                conn = connect()
            run_once(conn)
        except Exception as exc:
            print("Dispatcher error:", exc)
            conn = None  # reconnect on the next loop
        time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    main()
