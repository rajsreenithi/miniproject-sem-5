"""Create an AuraVision login user: python tools/create_user.py username admin"""
from getpass import getpass
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import bcrypt
from web.db_helpers import db_cursor, fetch_one


def main():
    if len(sys.argv) != 3:
        print("Usage: python tools/create_user.py <username> <admin|hod|viewer>")
        raise SystemExit(2)
    username, role = sys.argv[1].strip(), sys.argv[2].strip().lower()
    if not username or len(username) > 50:
        raise SystemExit("Username must be 1–50 characters.")
    if role not in ("admin", "hod", "viewer"):
        raise SystemExit("Role must be admin, hod, or viewer.")
    password = getpass("Password (minimum 12 characters): ")
    confirm = getpass("Confirm password: ")
    if len(password) < 12:
        raise SystemExit("Use a password with at least 12 characters.")
    if password != confirm:
        raise SystemExit("Passwords do not match.")
    if fetch_one("SELECT user_id FROM users WHERE username=%s", (username,)):
        raise SystemExit("That username already exists.")
    hashed = bcrypt.hashpw(password.encode("utf-8"), bcrypt.gensalt(rounds=12)).decode("utf-8")
    with db_cursor() as cur:
        cur.execute("INSERT INTO users (username,password_hash,role) VALUES (%s,%s,%s)", (username, hashed, role))
    print(f"Created user '{username}' with role '{role}'.")


if __name__ == "__main__":
    main()
