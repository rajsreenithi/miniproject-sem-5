"""Run the AuraVision vision engine on a video or webcam."""

import argparse
from pathlib import Path

import cv2

from engine.annotate import FrameAnnotator
from engine.detector import PersonDetector
from engine.heatmap import HeatmapAccumulator


def parse_source(value: str) -> str | int:
    """Interpret a numeric source as a webcam index."""
    if value.isdigit():
        return int(value)

    return value


def main() -> None:
    """Run detection, tracking, annotation, and heatmap accumulation."""
    parser = argparse.ArgumentParser(
        description="AuraVision vision-engine demonstration"
    )

    parser.add_argument(
        "source",
        help="Video file path or webcam index, such as 0",
    )
    parser.add_argument(
        "--weights",
        default="yolov8n.pt",
        help="YOLOv8 weights path (default: yolov8n.pt)",
    )
    parser.add_argument(
        "--conf",
        type=float,
        default=0.25,
        help="Detection confidence threshold",
    )
    parser.add_argument(
        "--imgsz",
        type=int,
        default=960,
        help="YOLO inference image size",
    )
    parser.add_argument(
        "--heatmap",
        default="heatmap.png",
        help="Output PNG path",
    )

    args = parser.parse_args()
    source = parse_source(args.source)

    if isinstance(source, str) and not Path(source).is_file():
        parser.error(f"Video file does not exist: {source}")

    detector = PersonDetector(
        weights=args.weights,
        conf=args.conf,
        imgsz=args.imgsz,
    )

    annotator = FrameAnnotator()
    capture = cv2.VideoCapture(source)

    if not capture.isOpened():
        raise RuntimeError(f"Could not open video source: {source}")

    heatmap: HeatmapAccumulator | None = None

    try:
        while True:
            success, frame = capture.read()

            if not success:
                break

            if heatmap is None:
                height, width = frame.shape[:2]
                heatmap = HeatmapAccumulator(
                    width=width,
                    height=height,
                )

            tracks = detector.process(frame)
            heatmap.update(tracks)

            annotated = annotator.annotate(
                frame=frame,
                tracks=tracks,
            )

            cv2.imshow("AuraVision Vision Engine", annotated)

            if cv2.waitKey(1) & 0xFF == ord("q"):
                break

    finally:
        capture.release()
        cv2.destroyAllWindows()

    if heatmap is not None:
        heatmap.save_png(args.heatmap)
        print(f"Heatmap saved to: {Path(args.heatmap).resolve()}")
    else:
        print("No frames were read; no heatmap was saved.")


if __name__ == "__main__":
    main()
