def _duration_filter(seconds):
    try:
        total = max(0, int(seconds or 0))
    except (TypeError, ValueError):
        total = 0
    hours, remainder = divmod(total, 3600)
    minutes, secs = divmod(remainder, 60)
    if hours:
        return f"{hours}h {minutes}m" if minutes else f"{hours}h"
    if minutes:
        return f"{minutes}m {secs}s" if secs else f"{minutes}m"
    return f"{secs}s"


def _parse_datetime(value):
    if value is None or value == "":
        return None
    if isinstance(value, datetime):
        return value
    if isinstance(value, date):
        return datetime.combine(value, datetime.min.time())
    try:
        return datetime.fromisoformat(str(value))
    except (TypeError, ValueError):
        return None


def _date_display(value):
    parsed = _parse_datetime(value)
    return parsed.strftime("%d %b %Y") if parsed else (str(value) if value else "—")


def _time_display(value):
    parsed = _parse_datetime(value)
    if parsed:
        return parsed.strftime("%H:%M")
    if value:
        try:
            return str(value)[:5]
        except Exception:
            pass
    return "—"


def _datetime_display(value):
    parsed = _parse_datetime(value)
    return parsed.strftime("%d %b %Y, %H:%M") if parsed else (str(value) if value else "—")


app.jinja_env.filters["duration"] = _duration_filter
app.jinja_env.filters["date_display"] = _date_display
app.jinja_env.filters["time_display"] = _time_display
app.jinja_env.filters["datetime_display"] = _datetime_display
