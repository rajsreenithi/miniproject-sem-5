from flask import Blueprint
from web.auth import login_required

auth_bp = Blueprint("auth", __name__, url_prefix="/auth")


@auth_bp.route("/login", methods=["GET", "POST"])
def login():
    if session.get("user"):
        return redirect(url_for("dashboard"))
    if request.method == "POST":
        locked, seconds = login_locked()
        if locked:
            flash(f"Too many failed attempts. Try again in about {seconds} seconds.", "danger")
            return render_template("login.html"), 429
        username = request.form.get("username", "").strip()
        password = request.form.get("password", "")
        if not username or not password:
            record_login_failure()
            flash("Enter both username and password.", "danger")
            return render_template("login.html"), 400
        try:
            user = verify_login(username, password)
        except Exception:
            app.logger.exception("Login database operation failed")
            flash("Sign-in is temporarily unavailable. Check the database connection.", "danger")
            return render_template("login.html"), 503
        if not user:
            record_login_failure()
            flash("Incorrect username or password.", "danger")
            return render_template("login.html"), 401
        clear_login_failures()
        session.clear()
        session["user"] = user
        session.permanent = True
        session["csrf_token"] = csrf_token()
        next_path = request.args.get("next", "")
        if not next_path.startswith("/") or next_path.startswith("//"):
            next_path = url_for("dashboard")
        return redirect(next_path)
    return render_template("login.html")


@auth_bp.route("/logout", methods=["POST"])
@login_required
def logout():
    session.clear()
    flash("You have been signed out.", "success")
    return redirect(url_for("auth.login"))


app.register_blueprint(auth_bp)


@app.route("/dashboard")
@login_required
def dashboard():
    try:
        sites, site = selected_site()
        if not site:
            return render_template("dashboard.html", sites=sites, site=None, kpis={"cameras": 0, "active": 0, "rules": 0, "open": 0})
        site_id = site["site_id"]
        kpis = {
            "cameras": fetch_one("SELECT COUNT(*) AS n FROM cameras WHERE site_id=%s", (site_id,))["n"],
            "active": fetch_one("SELECT COUNT(*) AS n FROM cameras WHERE site_id=%s AND is_active=1", (site_id,))["n"],
            "rules": fetch_one("SELECT COUNT(*) AS n FROM rules WHERE site_id=%s AND is_active=1", (site_id,))["n"],
            "open": fetch_one("SELECT COUNT(*) AS n FROM incidents i JOIN cameras c ON c.camera_id=i.camera_id WHERE c.site_id=%s AND i.status='open'", (site_id,))["n"],
        }
        incidents = fetch_all("SELECT i.incident_id,i.started_at,i.peak_count,i.status,c.name AS camera_name,c.floor_label FROM incidents i JOIN cameras c ON c.camera_id=i.camera_id WHERE c.site_id=%s ORDER BY i.started_at DESC LIMIT 8", (site_id,))
    except Exception:
        app.logger.exception("Dashboard query failed")
        flash("Could not load dashboard data. Confirm the database is running and schema is installed.", "danger")
        sites, site, kpis, incidents = [], None, {"cameras": 0, "active": 0, "rules": 0, "open": 0}, []
    return render_template("dashboard.html", sites=sites, site=site, kpis=kpis, incidents=incidents)


