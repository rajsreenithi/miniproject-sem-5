@app.context_processor
def inject_layout_context():
    user = session.get("user")
    try:
        sites, site = selected_site()
    except Exception:
        sites, site = [], None
    site_type = site.get("site_type") if site else "retail"
    labels = {"people_label": "Customers" if site_type == "retail" else "Students present",
              "incident_label": "Footfall" if site_type == "retail" else "Violations"}
    live_dir = os.path.join(BASE_DIR, "data", "live")
    now_ts = __import__("time").time()
    worker_online = False
    try:
        camera_rows = fetch_all(
            "SELECT camera_id FROM cameras WHERE site_id = %s AND is_active = %s",
            (site["site_id"], 1),
        ) if site else []
        worker_online = any(
            os.path.isfile(os.path.join(live_dir, f"camera_{row['camera_id']}.jpg"))
            and now_ts - os.path.getmtime(os.path.join(live_dir, f"camera_{row['camera_id']}.jpg")) <= 30
            for row in camera_rows
        )
    except (OSError, Exception):
        worker_online = False
    return {"current_user": user, "layout_sites": sites, "current_site": site,
            "worker_online": worker_online, **labels}


