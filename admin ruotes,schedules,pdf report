"""Administration routes. All SQL uses PyMySQL placeholders."""
from datetime import datetime

from flask import Blueprint, abort, flash, redirect, render_template, request, session, url_for

from web.auth import login_required, role_required
from web.db_helpers import db_cursor, fetch_all, fetch_one
from web.schedule_helpers import (
    parse_day_form, build_week_preview, get_right_now, build_form_values,
    build_schedule_view, build_day_timeline, build_week_summary,
)

admin_bp = Blueprint("admin", __name__)
DAYS = [(1, "Monday"), (2, "Tuesday"), (3, "Wednesday"), (4, "Thursday"), (5, "Friday"), (6, "Saturday"), (7, "Sunday")]


def selected_site():
    sites = fetch_all("SELECT site_id, name, site_type FROM sites ORDER BY name")
    valid_ids = {int(s["site_id"]) for s in sites}
    try:
        chosen = int(session.get("site_id", 0))
    except (TypeError, ValueError):
        chosen = 0
    if chosen not in valid_ids and sites:
        chosen = int(sites[0]["site_id"])
        session["site_id"] = chosen
    site = next((s for s in sites if int(s["site_id"]) == chosen), None)
    return sites, site


@admin_bp.route("/site", methods=["POST"])
def set_site():
    sites = fetch_all("SELECT site_id FROM sites")
    valid = {int(row["site_id"]) for row in sites}

    try:
        site_id = int(request.form.get("site_id", ""))
    except (TypeError, ValueError):
        site_id = -1

    if site_id not in valid:
        flash("Choose a valid site.", "danger")
    else:
        session["site_id"] = site_id
        flash("Site changed successfully.", "success")

    return redirect(url_for("dashboard"))

def _valid_day(value, default):
    try:
        number = int(value)
    except (TypeError, ValueError):
        return default
    return number if 1 <= number <= 7 else default


@admin_bp.route("/schedule", methods=["GET", "POST"])
@login_required
def schedule():
    sites, site = selected_site()
    user_role = session.get("user", {}).get("role", "viewer")
    can_edit = user_role in ("admin", "hod")
    today_num = datetime.now().isoweekday()
    selected_day = _valid_day(request.args.get("day"), today_num)

    if not site:
        return render_template(
            "schedule.html", sites=sites, site=None, days=DAYS, view=None,
            exceptions=[], can_edit=can_edit, errors={}, form_values={},
            selected_day=selected_day, today_num=today_num,
        )

    if site.get("site_type") != "water_point":
        flash("Schedules apply to the water-point site only.", "info")
        return redirect(url_for("dashboard"))

    errors = {}
    form_values = {}
    if request.method == "POST":
        if not can_edit:
            abort(403)
        action = request.form.get("action", "")
        if action == "save_day":
            try:
                source_day = int(request.form.get("day_of_week", "0"))
                if source_day not in range(1, 8):
                    raise ValueError("Choose a valid weekday.")
                selected_day = source_day
                source_values, source_slots, day_errors = parse_day_form(request.form, source_day)
                form_values.update(source_values)
                errors.update(day_errors)

                target_days = [source_day]
                for day_num, _day_name in DAYS:
                    if request.form.get(f"apply_{day_num}") == "1" and day_num != source_day:
                        target_days.append(day_num)

                if not errors:
                    with db_cursor() as cur:
                        for day_num in target_days:
                            cur.execute(
                                "DELETE FROM schedule_slots WHERE site_id=%s AND day_of_week=%s",
                                (site["site_id"], day_num),
                            )
                            for slot_start, slot_end, slot_type in source_slots:
                                cur.execute(
                                    """INSERT INTO schedule_slots
                                       (site_id, day_of_week, start_time, end_time, slot_type)
                                       VALUES (%s, %s, %s, %s, %s)""",
                                    (site["site_id"], day_num, slot_start, slot_end, slot_type),
                                )
                    names = [name for number, name in DAYS if number in target_days]
                    flash("Timetable saved for " + ", ".join(names) + ".", "success")
                    return redirect(url_for("admin.schedule", day=source_day, _anchor="editor"))
            except ValueError as exc:
                errors["general"] = str(exc)
        elif action == "clear_day":
            try:
                day_num = int(request.form.get("day_of_week", "0"))
                if day_num not in range(1, 8):
                    raise ValueError("Choose a valid weekday.")
                with db_cursor() as cur:
                    cur.execute(
                        "DELETE FROM schedule_slots WHERE site_id=%s AND day_of_week=%s",
                        (site["site_id"], day_num),
                    )
                flash("Timetable cleared for " + dict(DAYS)[day_num] + ".", "success")
                return redirect(url_for("admin.schedule", day=day_num, _anchor="editor"))
            except ValueError as exc:
                flash(str(exc), "danger")
                return redirect(url_for("admin.schedule"))
        elif action in ("exception_add", "exception_edit", "exception_delete"):
            try:
                if action == "exception_add":
                    on_date = datetime.strptime(request.form.get("on_date", ""), "%Y-%m-%d").date()
                    mode = request.form.get("mode", "")
                    note = request.form.get("note", "").strip()[:150]
                    if mode not in ("unrestricted", "restricted"):
                        raise ValueError("Choose a valid exception mode.")
                    with db_cursor() as cur:
                        cur.execute(
                            "INSERT INTO schedule_exceptions (site_id,on_date,mode,note) VALUES (%s,%s,%s,%s)",
                            (site["site_id"], on_date, mode, note or None),
                        )
                    flash("Schedule exception added.", "success")
                elif action == "exception_edit":
                    exception_id = int(request.form.get("exception_id", "0"))
                    on_date = datetime.strptime(request.form.get("on_date", ""), "%Y-%m-%d").date()
                    mode = request.form.get("mode", "")
                    note = request.form.get("note", "").strip()[:150]
                    if mode not in ("unrestricted", "restricted"):
                        raise ValueError("Choose a valid exception mode.")
                    with db_cursor() as cur:
                        cur.execute(
                            """UPDATE schedule_exceptions SET on_date=%s,mode=%s,note=%s
                               WHERE exception_id=%s AND site_id=%s""",
                            (on_date, mode, note or None, exception_id, site["site_id"]),
                        )
                    flash("Schedule exception updated.", "success")
                else:
                    exception_id = int(request.form.get("exception_id", "0"))
                    with db_cursor() as cur:
                        cur.execute(
                            "DELETE FROM schedule_exceptions WHERE exception_id=%s AND site_id=%s",
                            (exception_id, site["site_id"]),
                        )
                    flash("Schedule exception deleted.", "success")
                return redirect(url_for("admin.schedule"))
            except (ValueError, KeyError):
                flash("Please enter a valid date, mode, and exception.", "danger")
                return redirect(url_for("admin.schedule"))
        else:
            flash("Unknown schedule action.", "danger")
            return redirect(url_for("admin.schedule"))

    slots = fetch_all(
        """SELECT slot_id, site_id, day_of_week, start_time, end_time, slot_type
           FROM schedule_slots WHERE site_id=%s ORDER BY day_of_week,start_time""",
        (site["site_id"],),
    )
    exceptions = fetch_all(
        """SELECT exception_id,site_id,on_date,mode,note FROM schedule_exceptions
           WHERE site_id=%s ORDER BY on_date""",
        (site["site_id"],),
    )
    stored_values = build_form_values(slots)      # preload the editor with saved times
    stored_values.update(form_values)             # typed values win when validation failed
    view = build_schedule_view(slots, exceptions)
    day_view = build_day_timeline(slots, selected_day)
    week_summary = build_week_summary(slots)
    return render_template(
        "schedule.html", sites=sites, site=site, days=DAYS, view=view,
        day_view=day_view, week_summary=week_summary,
        exceptions=exceptions, can_edit=can_edit, errors=errors,
        form_values=stored_values, selected_day=selected_day, today_num=today_num,
    )
