"""Tests for directional line crossing."""

from datetime import datetime, timedelta

from engine.linecount import LineCounter
from engine.tracker import Track


def make_track(
    track_id: int,
    x: float,
    y: float,
) -> Track:
    """Create a synthetic track at a chosen foot point."""
    return Track(
        track_id=track_id,
        bbox=(int(x - 5), int(y - 10), int(x + 5), int(y)),
        foot_point=(x, y),
        confidence=0.90,
    )


def test_crossing_in_and_back_out() -> None:
    """Crossing a line in opposite directions emits opposite events."""
    counter = LineCounter(
        lines={
            1: ((0, 50), (100, 50)),
        }
    )

    start = datetime(2026, 10, 25, 10, 0, 0)

    # The point starts above the horizontal line.
    assert counter.update([make_track(10, 50, 40)], start) == []

    # Negative side to positive side means "in".
    crossings = counter.update(
        [make_track(10, 50, 60)],
        start + timedelta(seconds=1),
    )

    assert len(crossings) == 1
    assert crossings[0].line_id == 1
    assert crossings[0].track_id == 10
    assert crossings[0].direction == "in"

    # Remaining below the line must not produce duplicate counts.
    assert counter.update(
        [make_track(10, 50, 70)],
        start + timedelta(seconds=2),
    ) == []

    # Positive side to negative side means "out".
    crossings = counter.update(
        [make_track(10, 50, 40)],
        start + timedelta(seconds=3),
    )

    assert len(crossings) == 1
    assert crossings[0].direction == "out"
    assert crossings[0].ts == start + timedelta(seconds=3)


def test_multiple_tracks_are_independent() -> None:
    """Each track maintains independent crossing history."""
    counter = LineCounter(
        lines={
            1: ((0, 50), (100, 50)),
        }
    )

    now = datetime(2026, 10, 25, 11, 0, 0)

    counter.update(
        [
            make_track(1, 20, 40),
            make_track(2, 80, 60),
        ],
        now,
    )

    crossings = counter.update(
        [
            make_track(1, 20, 60),
            make_track(2, 80, 40),
        ],
        now + timedelta(seconds=1),
    )

    assert len(crossings) == 2

    directions = {
        crossing.track_id: crossing.direction
        for crossing in crossings
    }

    assert directions == {
        1: "in",
        2: "out",
    }


def test_points_on_line_do_not_duplicate_crossings() -> None:
    """A foot point on the line does not repeatedly trigger counts."""
    counter = LineCounter(
        lines={
            1: ((0, 50), (100, 50)),
        }
    )

    now = datetime(2026, 10, 25, 12, 0, 0)

    counter.update([make_track(5, 50, 40)], now)

    assert counter.update(
        [make_track(5, 50, 50)],
        now + timedelta(seconds=1),
    ) == []

    crossings = counter.update(
        [make_track(5, 50, 60)],
        now + timedelta(seconds=2),
    )

    assert len(crossings) == 1
    assert crossings[0].direction == "in"
