from datetime import datetime, timedelta

from rules.incidents import IncidentManager


class FakeClock:
    def __init__(self):
        self.now = datetime(2026, 10, 26, 10, 0, 0)

    def __call__(self):
        return self.now

    def advance(self, seconds):
        self.now += timedelta(seconds=seconds)


