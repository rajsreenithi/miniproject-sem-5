"""Build CONTEXT.md: brief + code map (signatures only) + DB schema."""
import ast
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SKIP = {"venv", "__pycache__", ".git", "data", "videos", "logs", "tests"}


def py_files():
    for p in sorted(ROOT.rglob("*.py")):
        rel = p.relative_to(ROOT)
        if any(part in SKIP for part in rel.parts):
            continue
        yield p


def sig(fn):
    return f"{fn.name}({', '.join(a.arg for a in fn.args.args)})"


def doc_line(node):
    doc = ast.get_docstring(node)
    return f"  # {doc.splitlines()[0]}" if doc else ""


def summarize(path):
    try:
        tree = ast.parse(path.read_text(encoding="utf-8"))
    except SyntaxError as exc:
        return [f"  (could not parse: {exc})"]
    lines = []
    for node in tree.body:
        if isinstance(node, ast.ClassDef):
            lines.append(f"  class {node.name}{doc_line(node)}")
            for item in node.body:
                if isinstance(item, ast.FunctionDef) and (
                    item.name == "__init__" or not item.name.startswith("_")
                ):
                    lines.append(f"    def {sig(item)}{doc_line(item)}")
        elif isinstance(node, ast.FunctionDef):
            lines.append(f"  def {sig(node)}{doc_line(node)}")
    return lines


def main():
    parts = []
    brief = ROOT / "context_brief.md"
    if brief.exists():
        parts.append(brief.read_text(encoding="utf-8"))

    code_map = ["## Code map (signatures only)"]
    for f in py_files():
        code_map.append(f"\n{f.relative_to(ROOT).as_posix()}")
        code_map.extend(summarize(f))
    parts.append("\n".join(code_map))

    schema = ROOT / "db" / "schema.sql"
    if schema.exists():
        parts.append(
            "## Database schema (FINAL)\n```sql\n"
            + schema.read_text(encoding="utf-8")
            + "\n```"
        )

    (ROOT / "CONTEXT.md").write_text("\n\n".join(parts), encoding="utf-8")
    print("CONTEXT.md written")


if __name__ == "__main__":
    main()
