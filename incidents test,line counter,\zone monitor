"""Tests for polygon presence and zone visit completion."""

from datetime import datetime, timedelta

from engine.tracker import Track
from engine.zones import ZoneMonitor


def make_track(
    track_id: int,
    x: float,
    y: float,
) -> Track:
    """Create a synthetic track with a chosen foot point."""
    return Track(
        track_id=track_id,
        bbox=(int(x - 5), int(y - 10), int(x + 5), int(y)),
        foot_point=(x, y),
        confidence=0.95,
    )


def test_zone_entry_and_delayed_exit() -> None:
    """A visit ends only after the outside grace period."""
    monitor = ZoneMonitor(
        zones={
            1: [
                (0, 0),
                (100, 0),
                (100, 100),
                (0, 100),
            ]
        },
        grace_sec=2,
    )

    start = datetime(2026, 10, 25, 10, 0, 0)

    counts, visits = monitor.update(
        [make_track(7, 50, 50)],
        start,
    )

    assert counts == {1: 1}
    assert visits == []

    # The person leaves the polygon.
    counts, visits = monitor.update(
        [make_track(7, 150, 50)],
        start + timedelta(seconds=5),
    )

    assert counts == {1: 1}
    assert visits == []

    # One second outside: still within the grace period.
    counts, visits = monitor.update(
        [],
        start + timedelta(seconds=6),
    )

    assert counts == {1: 1}
    assert visits == []

    # Two seconds outside: the visit is now complete.
    counts, visits = monitor.update(
        [],
        start + timedelta(seconds=7),
    )

    assert counts == {1: 0}
    assert len(visits) == 1

    visit = visits[0]
    assert visit.zone_id == 1
    assert visit.track_id == 7
    assert visit.entered_at == start
    assert visit.left_at == start + timedelta(seconds=5)
    assert visit.dwell_sec == 5


def test_return_inside_cancels_pending_exit() -> None:
    """Briefly leaving a zone must not create a second visit."""
    monitor = ZoneMonitor(
        zones={
            1: [
                (0, 0),
                (100, 0),
                (100, 100),
                (0, 100),
            ]
        },
        grace_sec=2,
    )

    start = datetime(2026, 10, 25, 11, 0, 0)

    monitor.update([make_track(3, 50, 50)], start)

    monitor.update(
        [make_track(3, 150, 50)],
        start + timedelta(seconds=3),
    )

    counts, visits = monitor.update(
        [make_track(3, 50, 50)],
        start + timedelta(seconds=4),
    )

    assert counts == {1: 1}
    assert visits == []

    # Leaving again starts a fresh grace period.
    monitor.update(
        [],
        start + timedelta(seconds=5),
    )

    counts, visits = monitor.update(
        [],
        start + timedelta(seconds=7),
    )

    assert counts == {1: 0}
    assert len(visits) == 1
    assert visits[0].entered_at == start
    assert visits[0].left_at == start + timedelta(seconds=5)
    assert visits[0].dwell_sec == 5


def test_multiple_zones_count_independently() -> None:
    """One person can be counted in the appropriate zone."""
    monitor = ZoneMonitor(
        zones={
            1: [(0, 0), (50, 0), (50, 50), (0, 50)],
            2: [(60, 0), (100, 0), (100, 50), (60, 50)],
        }
    )

    now = datetime(2026, 10, 25, 12, 0, 0)

    counts, visits = monitor.update(
        [
            make_track(1, 20, 20),
            make_track(2, 80, 20),
        ],
        now,
    )

    assert counts == {1: 1, 2: 1}
    assert visits == []
