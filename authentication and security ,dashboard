@dashboard_bp.route("/incidents")
@login_required
def incidents():
    site = _site()
    site_id = site["site_id"] if site else None

    today = date.today()
    start_value = request.args.get("start", today.isoformat())
    end_value = request.args.get("end", today.isoformat())
    status = request.args.get("status", "")

    try:
        start_date = date.fromisoformat(start_value)
    except ValueError:
        start_date = today
        start_value = today.isoformat()

    try:
        end_date = date.fromisoformat(end_value)
    except ValueError:
        end_date = today
        end_value = today.isoformat()

    if end_date < start_date:
        start_date, end_date = end_date, start_date
        start_value, end_value = end_value.isoformat(), start_value

    rows = _incident_rows(
        site_id,
        start_date=start_date,
        end_date=end_date,
        status=status,
    )

    worst_hours = []
    if site_id is not None:
        worst_hours = fetch_all(
            """
            SELECT HOUR(i.started_at) AS hour, COUNT(*) AS total
            FROM incidents i
            JOIN cameras c ON c.camera_id = i.camera_id
            WHERE c.site_id = %s
              AND i.started_at >= %s
              AND i.started_at < %s
            GROUP BY HOUR(i.started_at)
            ORDER BY total DESC, hour
            LIMIT 8
            """,
            (site_id, start_date, end_date + timedelta(days=1)),
        )

    max_worst = max(
        (int(row["total"] or 0) for row in worst_hours),
        default=0,
    )

    return render_template(
        "incidents.html",
        site=site,
        incidents=rows,
        start_value=start_value,
        end_value=end_value,
        status=status,
        worst_hours=worst_hours,
        max_worst=max_worst,
    )
