        abort(400, description="Use from=YYYY-MM-DD and to=YYYY-MM-DD.")
    if end_date < start_date or (end_date - start_date).days > 366:
        abort(400, description="Invalid report date range.")
    data = build_report_data(site, start_date, end_date)
    generated_by = (session.get("user") or {}).get("username", "Unknown user")
    pdf_bytes = build_pdf(data, generated_by)
    safe_site = "".join(ch if ch.isalnum() or ch in "-_" else "_" for ch in str(site.get("name", "site"))).strip("_") or "site"
    filename = f"AuraVision_{safe_site}_{start_date.isoformat()}_{end_date.isoformat()}.pdf"
    return send_file(io.BytesIO(pdf_bytes), mimetype="application/pdf", as_attachment=False, download_name=filename, max_age=0)


@dashboard_bp.route("/reports/export.csv")
@login_required
def export_report_csv():
    site = _site()
    if site is None:
        abort(404)
    try:
        start_date = date.fromisoformat(request.args.get("from", request.args.get("date", date.today().isoformat())))
        end_date = date.fromisoformat(request.args.get("to", start_date.isoformat()))
    except (TypeError, ValueError):
        abort(400, description="Use valid from and to dates.")
    if end_date < start_date or (end_date - start_date).days > 366:
        abort(400, description="Invalid report date range.")

    data = build_report_data(site, start_date, end_date)
    output = io.StringIO(newline="")
    writer = csv.writer(output)
    writer.writerow(["incident_id", "started_at", "ended_at", "duration_sec", "peak_count", "floor_label", "status", "alert_status", "rule_type"])
    for row in data["incidents"]:
        writer.writerow([row.get("incident_id"), row.get("started_at"), row.get("ended_at"), row.get("duration_sec"), row.get("peak_count"), row.get("floor_label") or "", row.get("status") or "", row.get("alert_status") or "No alerts", row.get("rule_type") or ""])

    response = make_response("\ufeff" + output.getvalue())
    response.headers["Content-Type"] = "text/csv; charset=utf-8"
    response.headers["Content-Disposition"] = f'attachment; filename="AuraVision_{site["site_id"]}_{start_date.isoformat()}_{end_date.isoformat()}.csv"'
    return response


