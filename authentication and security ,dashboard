"""Authentication, role authorization, and CSRF helpers."""
from functools import wraps
import hmac
import secrets
import time
import bcrypt
from flask import abort, flash, redirect, request, session, url_for
from web.db_helpers import fetch_one

# Per-process login throttling. For multi-worker deployment, move this to a shared store.
_FAILED = {}
_LOCK_SECONDS = 300
_WINDOW_SECONDS = 900
_MAX_FAILURES = 5


def csrf_token():
    token = session.get("csrf_token")
    if not token:
        token = secrets.token_urlsafe(32)
        session["csrf_token"] = token
    return token


def validate_csrf():
    supplied = request.form.get("csrf_token", "")
    expected = session.get("csrf_token", "")
    if not supplied or not expected or not hmac.compare_digest(supplied, expected):
        abort(400, description="The form security token is missing or expired. Please go back and try again.")


def _key():
    return (request.remote_addr or "unknown", request.form.get("username", "").strip().lower())


def login_locked():
    now = time.time()
    record = _FAILED.get(_key())
    if not record:
        return False, 0
    failures, first, locked_until = record
    if now < locked_until:
        return True, int(locked_until - now) + 1
    if now - first > _WINDOW_SECONDS:
        _FAILED.pop(_key(), None)
    return False, 0


def record_login_failure():
    now, key = time.time(), _key()
    failures, first, locked_until = _FAILED.get(key, (0, now, 0))
    if now - first > _WINDOW_SECONDS:
        failures, first = 0, now
    failures += 1
    if failures >= _MAX_FAILURES:
        locked_until = now + _LOCK_SECONDS
    _FAILED[key] = (failures, first, locked_until)


def clear_login_failures():
    _FAILED.pop(_key(), None)


def verify_login(username, password):
    user = fetch_one("SELECT user_id, username, password_hash, role FROM users WHERE username = %s", (username,))
    if not user:
        # Keep the response path similar for unknown users.
        bcrypt.checkpw(password.encode("utf-8"), bcrypt.hashpw(b"invalid-user-password", bcrypt.gensalt()))
        return None
    try:
        valid = bcrypt.checkpw(password.encode("utf-8"), user["password_hash"].encode("utf-8"))
    except (ValueError, TypeError):
        valid = False
    if not valid:
        return None
    return {"user_id": user["user_id"], "username": user["username"], "role": user["role"]}


def login_required(view):
    @wraps(view)
    def wrapped(*args, **kwargs):
        if not session.get("user"):
            flash("Please sign in to continue.", "warning")
            return redirect(url_for("auth.login", next=request.path))
        return view(*args, **kwargs)
    return wrapped


def role_required(*roles):
    def decorator(view):
        @wraps(view)
        @login_required
        def wrapped(*args, **kwargs):
            if session.get("user", {}).get("role") not in roles:
                abort(403)
            return view(*args, **kwargs)
        return wrapped
    return decorator
