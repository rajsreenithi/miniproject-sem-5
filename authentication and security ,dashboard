    filename = f"AuraVision_{safe_site}_{start_date.isoformat()}_{end_date.isoformat()}.pdf"
    return send_file(
        io.BytesIO(pdf_bytes), mimetype="application/pdf", as_attachment=True,
        download_name=filename, max_age=0,
    )


