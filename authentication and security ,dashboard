from datetime import date, datetime, timedelta
from pathlib import Path
import csv
import io

from flask import (
    Blueprint, abort, make_response, redirect, render_template,
    request, send_file, url_for
)

from web.auth import login_required
from web.db_helpers import fetch_all, fetch_one
from web.routes_admin import selected_site

dashboard_bp = Blueprint("dashboard_pages", __name__)

BASE_DIR = Path(__file__).resolve().parent.parent
LIVE_DIR = BASE_DIR / "data" / "live"
HEATMAP_DIR = BASE_DIR / "data" / "heatmaps"



def _site():
    sites, site = selected_site()

    if site is None:
        return None

    return site


def _site_id():
    site = _site()
    return site["site_id"] if site else None



def _site_cameras(site_id):
    if site_id is None:
        return []
    return fetch_all(
        """
        SELECT camera_id, name, floor_label, is_active
        FROM cameras
        WHERE site_id = %s
        ORDER BY name
        """,
        (site_id,),
    )


def _camera_for_site(camera_id, site_id):
    if not camera_id or site_id is None:
        return None
    return fetch_one(
        """
        SELECT camera_id, name, floor_label, is_active
        FROM cameras
        WHERE camera_id = %s AND site_id = %s
        """,
        (camera_id, site_id),
    )


def _latest_observations(site_id):
    if site_id is None:
        return []

    return fetch_all(
        """
        SELECT z.zone_id, z.name AS zone_name,
               c.camera_id, c.name AS camera_name,
               o.people_count, o.ts
        FROM zones z
        JOIN cameras c ON c.camera_id = z.camera_id
        LEFT JOIN observations o
          ON o.zone_id = z.zone_id
         AND o.camera_id = c.camera_id
         AND o.ts = (
             SELECT MAX(o2.ts)
             FROM observations o2
             WHERE o2.zone_id = z.zone_id
               AND o2.camera_id = c.camera_id
         )
        WHERE c.site_id = %s
        ORDER BY c.name, z.name
        """,
        (site_id,),
    )


def _incident_rows(site_id, start_date=None, end_date=None, status=None):
    if site_id is None:
        return []

    sql = """
        SELECT i.incident_id, i.started_at, i.ended_at,
               i.duration_sec, i.peak_count, i.status,
               c.camera_id, c.name AS camera_name, c.floor_label,
               r.rule_type,
               (
                   SELECT COUNT(*)
                   FROM alerts a
                   WHERE a.incident_id = i.incident_id
               ) AS alert_count
        FROM incidents i
        JOIN cameras c ON c.camera_id = i.camera_id
        JOIN rules r ON r.rule_id = i.rule_id
        WHERE c.site_id = %s
    """
    params = [site_id]

    if start_date:
        sql += " AND i.started_at >= %s"
        params.append(start_date)

    if end_date:
        sql += " AND i.started_at < %s"
        params.append(end_date + timedelta(days=1))

    if status in ("open", "closed"):
        sql += " AND i.status = %s"
        params.append(status)

    sql += " ORDER BY i.started_at DESC LIMIT 500"
    return fetch_all(sql, tuple(params))


def _camera_health(camera_id):
    """Return camera image freshness and the worker command for a camera."""
    image_path = LIVE_DIR / f"camera_{camera_id}.jpg"
    age = (datetime.now().timestamp() - image_path.stat().st_mtime) if image_path.is_file() else None
    return {
        "online": age is not None and age <= 30,
        "age_sec": int(age) if age is not None else None,
        "image_exists": image_path.is_file(),
        "command": f"python worker.py --camera-id {camera_id} --loop",
    }


def _all_hours(rows):
    """Always return all 24 hours, including hours with zero activity."""
    totals = {int(row["hour"]): int(row["total"] or 0) for row in rows}
    return [{"hour": hour, "total": totals.get(hour, 0)} for hour in range(24)]


def _schedule_for_site(site_id):
    if site_id is None:
        return [], []
    slots = fetch_all(
        """SELECT slot_id, site_id, day_of_week, start_time, end_time, slot_type
           FROM schedule_slots WHERE site_id = %s
           ORDER BY day_of_week, start_time, slot_id""", (site_id,))
    exceptions = fetch_all(
        """SELECT exception_id, site_id, on_date, mode, note
           FROM schedule_exceptions WHERE site_id = %s
           ORDER BY on_date, exception_id""", (site_id,))
    return slots, exceptions


@dashboard_bp.route("/dashboard")
@login_required
def dashboard():
    from rules.engine import is_restricted_for_schedule, schedule_period_label

    site = _site()
    site_id = site["site_id"] if site else None
    now = datetime.now()
    today = now.date()
    midnight = datetime.combine(today, datetime.min.time())
    tomorrow = midnight + timedelta(days=1)

    people_now = open_incidents = entries_today = exits_today = avg_dwell = 0
    zones, recent_incidents, hourly = [], [], []
    cameras, camera_tiles = [], []
    heatmap_camera = None
    busiest_hour = None
    longest_gathering = 0
    peak_count_today = 0
    violations_today = 0
    compliance_pct = 100
    current_period = "Outside college hours"
    restricted = False
    last_alert = None
    class_hours = []
    break_hours = []
    occupancy_limit = 2

    if site_id is not None:
        latest = _latest_observations(site_id)
        zones = latest
        people_now = sum(int(row["people_count"] or 0) for row in latest
                         if row.get("people_count") is not None)

        cameras = _site_cameras(site_id)
        camera_tiles = []
        for camera in cameras:
            health = _camera_health(camera["camera_id"])
            count_rows = [r for r in latest if r["camera_id"] == camera["camera_id"]]
            camera_tiles.append({
                **camera, **health,
                "people_count": sum(int(r["people_count"] or 0) for r in count_rows
                                    if r.get("people_count") is not None),
                "last_update": max((r["ts"] for r in count_rows if r.get("ts")), default=None),
            })
        heatmap_camera = next((c for c in cameras
                               if (HEATMAP_DIR / f"camera_{c['camera_id']}.png").is_file()), None)

        row = fetch_one(
            """SELECT COUNT(*) AS total FROM incidents i
               JOIN cameras c ON c.camera_id=i.camera_id
               WHERE c.site_id=%s AND i.status='open'""", (site_id,))
        open_incidents = int(row["total"] or 0) if row else 0

        row = fetch_one(
            """SELECT COUNT(*) AS total FROM crossings x JOIN cameras c ON c.camera_id=x.camera_id
               WHERE c.site_id=%s AND x.direction='in' AND x.ts >= %s AND x.ts < %s""",
            (site_id, midnight, tomorrow))
        entries_today = int(row["total"] or 0) if row else 0
        row = fetch_one(
            """SELECT COUNT(*) AS total FROM crossings x JOIN cameras c ON c.camera_id=x.camera_id
               WHERE c.site_id=%s AND x.direction='out' AND x.ts >= %s AND x.ts < %s""",
            (site_id, midnight, tomorrow))
        exits_today = int(row["total"] or 0) if row else 0
        row = fetch_one(
            """SELECT AVG(v.dwell_sec) AS average_dwell FROM visits v
               JOIN cameras c ON c.camera_id=v.camera_id
               WHERE c.site_id=%s AND v.entered_at >= %s AND v.entered_at < %s""",
            (site_id, midnight, tomorrow))
        avg_dwell = round(float(row["average_dwell"] or 0)) if row else 0

        raw_hourly = fetch_all(
            """SELECT HOUR(x.ts) AS hour, COUNT(*) AS total
               FROM crossings x JOIN cameras c ON c.camera_id=x.camera_id
               WHERE c.site_id=%s AND x.ts >= %s AND x.ts < %s
               GROUP BY HOUR(x.ts) ORDER BY hour""", (site_id, midnight, tomorrow))
        hourly = _all_hours(raw_hourly)
        busiest = max(hourly, key=lambda item: item["total"], default=None)
        busiest_hour = busiest["hour"] if busiest and busiest["total"] else None
        recent_incidents = _incident_rows(site_id)[:8]

        rule = fetch_one(
            """SELECT min_people FROM rules
               WHERE site_id=%s AND rule_type='occupancy_limit' AND is_active=1
               ORDER BY rule_id LIMIT 1""", (site_id,))
        occupancy_limit = max(1, int(rule["min_people"])) if rule else 2
        for zone in zones:
            count = zone.get("people_count")
            zone["capacity"] = occupancy_limit
            zone["percent"] = min(100, round((int(count or 0) / occupancy_limit) * 100))
            if count is None:
                zone["occupancy_state"] = "No data"
            elif int(count) > occupancy_limit:
                zone["occupancy_state"] = "Over limit"
            elif int(count) >= occupancy_limit:
                zone["occupancy_state"] = "Busy"
            else:
                zone["occupancy_state"] = "Normal"

        slots, exceptions = _schedule_for_site(site_id)
        current_period = schedule_period_label(now, slots, exceptions)
        restricted = is_restricted_for_schedule(now, slots, exceptions)
        from rules.engine import _as_time
        class_hours, break_hours = set(), set()
        for slot in slots:
            if int(slot["day_of_week"]) != now.isoweekday():
                continue
            start_time, end_time = _as_time(slot["start_time"]), _as_time(slot["end_time"])
            target = class_hours if slot["slot_type"] == "class" else break_hours
            for hour in range(24):
                probe = datetime.combine(today, datetime.min.time()).replace(hour=hour).time()
                covered = (start_time <= probe < end_time) if start_time <= end_time else (probe >= start_time or probe < end_time)
                if covered:
                    target.add(hour)
        class_hours, break_hours = sorted(class_hours), sorted(break_hours)

        row = fetch_one(
            """SELECT COUNT(*) AS total, COALESCE(MAX(i.peak_count),0) AS peak
               FROM incidents i JOIN cameras c ON c.camera_id=i.camera_id
               WHERE c.site_id=%s AND i.started_at >= %s AND i.started_at < %s
                 AND i.rule_id IN (SELECT rule_id FROM rules WHERE site_id=%s AND rule_type='restricted_presence')""",
            (site_id, midnight, tomorrow, site_id))
        violations_today = int(row["total"] or 0) if row else 0
        peak_count_today = int(row["peak"] or 0) if row else 0
        longest_row = fetch_one(
            """SELECT MAX(COALESCE(i.duration_sec,
                      TIMESTAMPDIFF(SECOND,i.started_at,%s))) AS longest
               FROM incidents i JOIN cameras c ON c.camera_id=i.camera_id
               JOIN rules r ON r.rule_id=i.rule_id
               WHERE c.site_id=%s AND r.rule_type='restricted_presence'
                 AND i.started_at >= %s AND i.started_at < %s""",
            (now, site_id, midnight, tomorrow))
        longest_gathering = int(longest_row["longest"] or 0) if longest_row else 0

        # Compliance is the share of today's class-period camera checks without an active violation.
        class_slot_count = sum(1 for s in slots if int(s["day_of_week"]) == now.isoweekday()
                               and s["slot_type"] == "class")
        expected_checks = max(1, class_slot_count * max(1, len(cameras)))
        compliance_pct = max(0, min(100, round((1 - violations_today / expected_checks) * 100)))

        last_alert = fetch_one(
            """SELECT a.status, a.sent_at, a.error_msg, r.name AS recipient_name,
                      i.started_at
               FROM alerts a JOIN incidents i ON i.incident_id=a.incident_id
               JOIN cameras c ON c.camera_id=i.camera_id
               JOIN recipients r ON r.recipient_id=a.recipient_id
               WHERE c.site_id=%s ORDER BY a.alert_id DESC LIMIT 1""", (site_id,))

    max_hourly = max((item["total"] for item in hourly), default=0)
    is_water = bool(site and site.get("site_type") == "water_point")
    return render_template(
        "dashboard.html", site=site, today=today, now=now,
        people_now=people_now, open_incidents=open_incidents,
        entries_today=entries_today, exits_today=exits_today, avg_dwell=avg_dwell,
        zones=zones, recent_incidents=recent_incidents, hourly=hourly,
        max_hourly=max_hourly, busiest_hour=busiest_hour, cameras=cameras,
        camera_tiles=camera_tiles, heatmap_camera=heatmap_camera,
        occupancy_limit=occupancy_limit, is_water=is_water,
        current_period=current_period, restricted=restricted,
        violations_today=violations_today, longest_gathering=longest_gathering,
        peak_count_today=peak_count_today, compliance_pct=compliance_pct,
        last_alert=last_alert, class_hours=class_hours, break_hours=break_hours,
        worker_online=any(c["online"] for c in camera_tiles),
    )


