"""MySQL connection helpers for AuraVision.

Reads DB_HOST, DB_USER, DB_PASSWORD and DB_NAME from a .env file in the
project root (or from the process environment). Uses parameterized SQL in
callers; this module deliberately exposes a connection, not SQL interpolation.
"""
from __future__ import annotations

import os
import time
from contextlib import contextmanager
from pathlib import Path
from typing import Iterator

import pymysql
from pymysql.connections import Connection


def _load_env_file() -> None:
    """Load simple KEY=VALUE entries from the project-root .env without overriding environment."""
    env_path = Path(__file__).resolve().parents[1] / ".env"
    if not env_path.exists():
        return
    for raw_line in env_path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip().strip('"').strip("'")
        if key and key not in os.environ:
            os.environ[key] = value


def _settings() -> dict:
    _load_env_file()
    return {
        "host": os.getenv("DB_HOST", "127.0.0.1"),
        "user": os.getenv("DB_USER", "root"),
        "password": os.getenv("DB_PASSWORD", ""),
        "database": os.getenv("DB_NAME", "auravision"),
        "charset": "utf8mb4",
        "cursorclass": pymysql.cursors.DictCursor,
        "autocommit": False,
        "connect_timeout": 5,
        "read_timeout": 10,
        "write_timeout": 10,
    }


def connect_with_retry(attempts: int = 3, delay_sec: float = 1.0) -> Connection:
    """Connect to MySQL, retrying transient connection failures."""
    if attempts < 1:
        raise ValueError("attempts must be at least 1")
    last_error = None
    for attempt in range(attempts):
        try:
            return pymysql.connect(**_settings())
        except pymysql.MySQLError as exc:
            last_error = exc
            if attempt + 1 < attempts:
                time.sleep(delay_sec * (attempt + 1))
    assert last_error is not None
    raise last_error


@contextmanager
def get_connection(attempts: int = 3, delay_sec: float = 1.0) -> Iterator[Connection]:
    """Yield a connection and commit on success; roll back on exceptions."""
    connection = connect_with_retry(attempts=attempts, delay_sec=delay_sec)
    try:
        yield connection
        connection.commit()
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()
