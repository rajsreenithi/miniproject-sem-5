"""Transactional incident lifecycle management."""
from __future__ import annotations

from datetime import datetime, timedelta
from typing import Any, Callable


def _rows(cursor: Any) -> list[dict[str, Any]]:
    result = cursor.fetchall()
    if not result:
        return []
    if isinstance(result[0], dict):
        return result
    names = [column[0] for column in cursor.description]
    return [dict(zip(names, row)) for row in result]


class IncidentManager:
    """Manage incidents for one camera using an injectable clock."""

    def __init__(
        self,
        camera_id: int,
        site_id: int,
        connection_factory: Callable[[], Any],
        clock: Callable[[], datetime] = datetime.now,
    ) -> None:
        self.camera_id = int(camera_id)
        self.site_id = int(site_id)
        self.connection_factory = connection_factory
        self.clock = clock
        self._below_since: dict[int, datetime] = {}

    @staticmethod
    def _count_tracks(
        dwell_by_track: dict[tuple[int, int], float],
        min_duration_sec: int,
    ) -> int:
        """Count unique tracks that meet the dwell threshold in any zone."""
        return len({
            track_id
            for (_, track_id), dwell in dwell_by_track.items()
            if float(dwell) >= int(min_duration_sec)
        })

    def evaluate(
        self,
        dwell_by_track: dict[tuple[int, int], float],
        rule_engine: Any,
        now: datetime | None = None,
    ) -> None:
        """Evaluate each eligible rule; each DB change is transactional."""
        now = now or self.clock()
        rules = rule_engine.get_rules(now)

        for rule in rules:
            rule_id = int(rule["rule_id"])
            count = self._count_tracks(
                dwell_by_track, int(rule["min_duration_sec"])
            )
            minimum = int(rule["min_people"])

            try:
                with self.connection_factory() as connection:
                    with connection.cursor() as cursor:
                        cursor.execute(
                            """
                            SELECT incident_id, started_at, ended_at,
                                   peak_count, status
                            FROM incidents
                            WHERE camera_id = %s AND rule_id = %s
                            ORDER BY started_at DESC, incident_id DESC
                            LIMIT 1
                            FOR UPDATE
                            """,
                            (self.camera_id, rule_id),
                        )
                        found = _rows(cursor)
                        latest = found[0] if found else None

                        if count >= minimum:
                            self._below_since.pop(rule_id, None)

                            if latest and latest["ended_at"] is None:
                                cursor.execute(
                                    """
                                    UPDATE incidents
                                    SET peak_count = GREATEST(peak_count, %s)
                                    WHERE incident_id = %s
                                      AND ended_at IS NULL
                                    """,
                                    (count, latest["incident_id"]),
                                )
                                continue

                            if latest and latest["ended_at"] is not None:
                                ended_at = latest["ended_at"]
                                if isinstance(ended_at, str):
                                    ended_at = datetime.fromisoformat(ended_at)

                                elapsed = (now - ended_at).total_seconds()
                                if elapsed <= int(rule["cooldown_sec"]):
                                    cursor.execute(
                                        """
                                        UPDATE incidents
                                        SET ended_at = NULL,
                                            duration_sec = NULL,
                                            status = 'open',
                                            peak_count = GREATEST(peak_count, %s)
                                        WHERE incident_id = %s
                                        """,
                                        (count, latest["incident_id"]),
                                    )
                                    continue

                            cursor.execute(
                                """
                                INSERT INTO incidents
                                    (camera_id, rule_id, started_at, peak_count)
                                VALUES (%s, %s, %s, %s)
                                """,
                                (self.camera_id, rule_id, now, count),
                            )
                            incident_id = cursor.lastrowid

                            cursor.execute(
                                """
                                SELECT recipient_id
                                FROM recipients
                                WHERE site_id = %s
                                ORDER BY recipient_id
                                """,
                                (self.site_id,),
                            )
                            recipients = _rows(cursor)

                            for recipient in recipients:
                                cursor.execute(
                                    """
                                    INSERT INTO alerts
                                        (incident_id, recipient_id, status)
                                    VALUES (%s, %s, %s)
                                    """,
                                    (
                                        incident_id,
                                        recipient["recipient_id"],
                                        "pending",
                                    ),
                                )

                        elif latest and latest["ended_at"] is None:
                            below_since = self._below_since.setdefault(
                                rule_id, now
                            )
                            elapsed = (now - below_since).total_seconds()

                            if elapsed >= int(rule["clear_after_sec"]):
                                cursor.execute(
                                    """
                                    UPDATE incidents
                                    SET ended_at = %s
                                    WHERE incident_id = %s
                                      AND ended_at IS NULL
                                    """,
                                    (now, latest["incident_id"]),
                                )
                                self._below_since.pop(rule_id, None)

                        else:
                            self._below_since.pop(rule_id, None)

            except Exception:
                # The connection context manager must roll back on failure.
                # Do not suppress DB failures: the worker logs them.
                raise
