"""Parameterized database queries for the AuraVision worker."""
from __future__ import annotations

from datetime import date
from typing import Iterable, Mapping, Any

from db.connection import get_connection


def load_camera_config(camera_id: int) -> dict:
    """Return camera metadata, zones with ordered polygon points, and count lines."""
    with get_connection() as conn:
        with conn.cursor() as cur:
            cur.execute(
                """SELECT camera_id, site_id, name, floor_label, source_type,
                          source_uri, frame_stride, is_active
                   FROM cameras WHERE camera_id = %s""",
                (camera_id,),
            )
            camera = cur.fetchone()
            if camera is None:
                raise ValueError(f"Camera {camera_id} does not exist")
            cur.execute(
                """SELECT zone_id, camera_id, name
                   FROM zones WHERE camera_id = %s ORDER BY zone_id""",
                (camera_id,),
            )
            zones = cur.fetchall()
            for zone in zones:
                cur.execute(
                    """SELECT seq, x, y FROM zone_points
                       WHERE zone_id = %s ORDER BY seq""",
                    (zone["zone_id"],),
                )
                zone["points"] = cur.fetchall()
                zone["polygon"] = [(int(p["x"]), int(p["y"])) for p in zone["points"]]
            cur.execute(
                """SELECT line_id, camera_id, name, x1, y1, x2, y2
                   FROM count_lines WHERE camera_id = %s ORDER BY line_id""",
                (camera_id,),
            )
            lines = cur.fetchall()
    return {"camera": camera, "zones": zones, "count_lines": lines}


def load_schedule(site_id: int) -> list[dict]:
    """Load weekly schedule slots and date-specific exceptions for a site."""
    with get_connection() as conn:
        with conn.cursor() as cur:
            cur.execute(
                """SELECT slot_id, site_id, day_of_week, start_time, end_time, slot_type
                   FROM schedule_slots WHERE site_id = %s
                   ORDER BY day_of_week, start_time""",
                (site_id,),
            )
            slots = cur.fetchall()
            cur.execute(
                """SELECT exception_id, site_id, on_date, mode, note
                   FROM schedule_exceptions WHERE site_id = %s ORDER BY on_date""",
                (site_id,),
            )
            exceptions = cur.fetchall()
    return {"slots": slots, "exceptions": exceptions}


def insert_observations(rows: Iterable[Mapping[str, Any]], batch_size: int = 500) -> int:
    """Batch insert rows with camera_id, zone_id, ts, people_count."""
    values = [
        (int(r["camera_id"]), int(r["zone_id"]), r["ts"], int(r["people_count"]))
        for r in rows
    ]
    if not values:
        return 0
    sql = """INSERT INTO observations (camera_id, zone_id, ts, people_count)
             VALUES (%s, %s, %s, %s)"""
    total = 0
    with get_connection() as conn:
        with conn.cursor() as cur:
            for start in range(0, len(values), batch_size):
                batch = values[start:start + batch_size]
                cur.executemany(sql, batch)
                total += cur.rowcount
    return total


