def daily_report(site_id: int, report_date: date) -> list[dict]:
    """Python equivalent of the daily_report stored procedure."""
    with get_connection() as conn:
        with conn.cursor() as cur:
            cur.execute(
                """SELECT c.floor_label, i.started_at, i.ended_at,
                          i.duration_sec, i.peak_count
                   FROM incidents AS i
                   JOIN cameras AS c ON c.camera_id = i.camera_id
                   WHERE c.site_id = %s
                     AND i.started_at >= %s
                     AND i.started_at < %s + INTERVAL 1 DAY
                   ORDER BY i.started_at""",
                (site_id, report_date, report_date),
            )
            return cur.fetchall()
