"""Directional line-crossing detection using track foot points."""

from dataclasses import dataclass
from datetime import datetime
from typing import Mapping, Sequence

from engine.tracker import Point, Track


Line = tuple[Point, Point]


@dataclass(frozen=True, slots=True)
class Crossing:
    """A detected crossing of a counting line."""

    line_id: int
    track_id: int
    direction: str
    ts: datetime


class LineCounter:
    """Detect directional crossings for persistent person track IDs."""

    def __init__(
        self,
        lines: Mapping[int, Line],
        epsilon: float = 1e-6,
    ) -> None:
        """Initialize directed lines and the side-change tolerance."""
        if epsilon < 0:
            raise ValueError("epsilon cannot be negative")

        self.lines: dict[int, Line] = {
            int(line_id): (
                (float(endpoints[0][0]), float(endpoints[0][1])),
                (float(endpoints[1][0]), float(endpoints[1][1])),
            )
            for line_id, endpoints in lines.items()
        }

        for line_id, (start, end) in self.lines.items():
            if start == end:
                raise ValueError(f"Line {line_id} has zero length")

        self.epsilon = epsilon
        self._last_side: dict[tuple[int, int], int] = {}

    @staticmethod
    def _cross_product(
        start: Point,
        end: Point,
        point: Point,
    ) -> float:
        """Return the signed cross product relative to a directed line."""
        return (
            (end[0] - start[0]) * (point[1] - start[1])
            - (end[1] - start[1]) * (point[0] - start[0])
        )

    def update(
        self,
        tracks: Sequence[Track],
        now: datetime,
    ) -> list[Crossing]:
        """Return crossings observed between the previous and current frames."""
        crossings: list[Crossing] = []

        for track in tracks:
            for line_id, (start, end) in self.lines.items():
                value = self._cross_product(
                    start,
                    end,
                    track.foot_point,
                )

                if abs(value) <= self.epsilon:
                    # Keep the last non-zero side while the point is on
                    # the line, preventing repeated counts on its boundary.
                    continue

                current_side = 1 if value > 0 else -1
                key = (line_id, track.track_id)
                previous_side = self._last_side.get(key)

                if previous_side is not None and current_side != previous_side:
                    direction = (
                        "in"
                        if previous_side == -1 and current_side == 1
                        else "out"
                    )

                    crossings.append(
                        Crossing(
                            line_id=line_id,
                            track_id=track.track_id,
                            direction=direction,
                            ts=now,
                        )
                    )

                self._last_side[key] = current_side

        return crossings

    def reset(self) -> None:
        """Clear side history before processing an independent video."""
        self._last_side.clear()
