.time-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}
.break-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem}
.field-error{color:#b42318;font-size:.82rem;margin-top:.25rem}
@media(max-width:760px){.break-grid{grid-template-columns:1fr}.time-pair{gap:.5rem}}
</style>
{% endblock %}
{% block content %}
<div class="page-heading"><div><div class="breadcrumbs">Workspace <span>/</span> Schedule</div><h1>Daily timetable</h1><p>Water-point class periods, breaks, and holiday or exam exceptions.</p></div></div>

{% if not site %}
<section class="panel empty-state"><h3>No site selected</h3><p>Select a water-point site to view its timetable.</p></section>
{% else %}
{% set info = view.now_info %}
<div class="now-banner state-{{ info.state }}" role="status">
  <span class="now-dot"></span>
  <div><strong>Right now ({{ view.now_label }}): {{ info.headline }}</strong><span class="detail">{{ info.detail }}</span></div>
</div>
{% if errors.general %}<div class="alert alert-danger">{{ errors.general }}</div>{% endif %}

<section class="panel mb-4">
  <form method="get" action="{{ url_for('admin.schedule') }}#timeline" class="row g-2 align-items-end">
    <div class="col-sm-6 col-md-4">
      <label class="form-label" for="day_select">Choose a day</label>
      <select class="form-select" id="day_select" name="day">
        {% for n, name in days %}<option value="{{ n }}" {% if n == selected_day %}selected{% endif %}>{{ name }}{% if n == today_num %} (today){% endif %}</option>{% endfor %}
      </select>
    </div>
    <div class="col-auto"><button class="btn btn-primary" type="submit">Show</button></div>
  </form>
</section>

<section class="panel mb-4" id="timeline">
  <div class="panel-heading"><div><h2>{{ day_view.day_name }} timeline</h2><p>{{ day_view.summary }}</p></div></div>
  {% if day_view.has_timetable %}
  <div class="tl-legend"><span><i class="class"></i>Class — not allowed</span><span><i class="break"></i>Break — allowed</span>{% if day_view.segments|selectattr('kind','equalto','gap')|list %}<span><i class="gap"></i>No slot saved</span>{% endif %}</div>
  <div class="tl2-scroll"><div class="tl2">
    <div class="tl2-labels">
      {% for l in day_view.labels %}<span class="tl2-label lvl{{ l.level }} {{ l.align }}" style="left:{{ '%.3f'|format(l.left) }}%">{{ l.text }}</span>{% endfor %}
    </div>
    <div class="tl2-strip" role="img" aria-label="{{ day_view.day_name }} timeline of class and break periods">
      {% for s in day_view.segments %}
      <div class="tl2-seg {{ s.kind }}" style="left:{{ '%.3f'|format(s.left) }}%;width:{{ '%.3f'|format(s.width) }}%" title="{{ s.name }} {{ s.start_label }}–{{ s.end_label }} ({{ s.length_label }}) — {{ s.label }}">
        {% if s.show_text %}<span>{{ s.label }}</span>{% if s.show_length %}<small>{{ s.length_label }}</small>{% endif %}{% endif %}
      </div>
      {% endfor %}
      {% if day_view.now_left is not none %}<i class="tl2-nowline" style="left:{{ '%.3f'|format(day_view.now_left) }}%"></i>{% endif %}
    </div>
    <div class="tl2-nowrow">{% if day_view.now_left is not none %}<span class="tl2-nowtag" style="left:{{ '%.3f'|format(day_view.now_left) }}%">▲ Now {{ day_view.now_label }}</span>{% endif %}</div>
  </div></div>
  {% if day_view.is_today and day_view.now_left is none %}<p class="text-muted small mb-3">The time now ({{ day_view.now_label }}) is outside today's college hours.</p>{% endif %}

  <div class="table-responsive"><table class="table table-sm align-middle mb-0">
    <thead><tr><th>Period</th><th>From</th><th>To</th><th>Length</th><th>Gathering</th></tr></thead>
    <tbody>{% for s in day_view.segments %}<tr>
      <td>{{ s.name }}</td><td>{{ s.start_label }}</td><td>{{ s.end_label }}</td><td>{{ s.length_label }}</td>
      <td>{% if s.kind == 'class' %}<span class="badge text-bg-danger">Not allowed</span>{% elif s.kind == 'break' %}<span class="badge text-bg-success">Allowed</span>{% else %}<span class="badge text-bg-secondary">No slot</span>{% endif %}</td>
    </tr>{% endfor %}</tbody>
  </table></div>
  {% else %}
  <div class="table-empty"><strong>No timetable saved for {{ day_view.day_name }}</strong><span>Use the editor below to add the college hours and up to 3 breaks.</span></div>
  {% endif %}
</section>

{% if can_edit %}
<section class="panel mb-4" id="editor">
  <div class="panel-heading"><div><h2>Edit {{ day_view.day_name }}</h2><p>Set the college hours and up to 3 breaks. Class periods are created automatically between the breaks.</p></div></div>
  {% set prefix = 'day_' ~ selected_day ~ '_' %}
  <form class="day-editor" method="post" action="{{ url_for('admin.schedule') }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
    <input type="hidden" name="action" value="save_day">
    <input type="hidden" name="day_of_week" value="{{ selected_day }}">
    <div class="time-pair mb-3">
      <div><label class="form-label" for="{{ prefix }}start">College day starts</label>
        <input class="form-control" id="{{ prefix }}start" type="time" name="{{ prefix }}start" value="{{ form_values.get(prefix ~ 'start','') }}" required>
        {% if errors.get(prefix ~ 'start') %}<div class="field-error">{{ errors.get(prefix ~ 'start') }}</div>{% endif %}</div>
      <div><label class="form-label" for="{{ prefix }}end">College day ends</label>
        <input class="form-control" id="{{ prefix }}end" type="time" name="{{ prefix }}end" value="{{ form_values.get(prefix ~ 'end','') }}" required>
        {% if errors.get(prefix ~ 'end') %}<div class="field-error">{{ errors.get(prefix ~ 'end') }}</div>{% endif %}</div>
    </div>
    <h3 class="h6">Optional breaks (up to 3)</h3>
    <div class="break-grid">
      {% for n in [1,2,3] %}{% set bp = prefix ~ 'break_' ~ n ~ '_' %}
      <div class="border rounded-3 p-3">
        <div class="fw-semibold mb-2">Break {{ n }}</div>
        <label class="form-label" for="{{ bp }}start">Start</label>
        <input class="form-control mb-1" id="{{ bp }}start" type="time" name="{{ bp }}start" value="{{ form_values.get(bp ~ 'start','') }}">
        {% if errors.get(bp ~ 'start') %}<div class="field-error">{{ errors.get(bp ~ 'start') }}</div>{% endif %}
        <label class="form-label mt-2" for="{{ bp }}end">End</label>
        <input class="form-control" id="{{ bp }}end" type="time" name="{{ bp }}end" value="{{ form_values.get(bp ~ 'end','') }}">
        {% if errors.get(bp ~ 'end') %}<div class="field-error">{{ errors.get(bp ~ 'end') }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
    <fieldset class="mt-3">
      <legend class="fs-6">Also apply this timetable to</legend>
      <div class="d-flex flex-wrap gap-3">
        {% for n, name in days %}{% if n != selected_day %}<label class="form-check-label"><input class="form-check-input me-1" type="checkbox" name="apply_{{ n }}" value="1"> {{ name }}</label>{% endif %}{% endfor %}
      </div>
      <div class="form-text">Checked days are replaced with this timetable when you save.</div>
    </fieldset>
    <div class="d-flex flex-wrap gap-2 mt-3">
      <button class="btn btn-primary" type="submit">Save {{ day_view.day_name }}</button>
      <button class="btn btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#clearDayModal">Clear this day</button>
    </div>
  </form>

  <div class="modal fade" id="clearDayModal" tabindex="-1" aria-labelledby="clearDayLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
      <form method="post" action="{{ url_for('admin.schedule') }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="action" value="clear_day">
        <input type="hidden" name="day_of_week" value="{{ selected_day }}">
        <div class="modal-header"><h5 class="modal-title" id="clearDayLabel">Clear {{ day_view.day_name }}?</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body">This removes every class and break slot for {{ day_view.day_name }}. With no timetable, no restrictions apply on that day.</div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger">Clear day</button></div>
      </form>
    </div></div>
  </div>
</section>
{% else %}
<div class="alert alert-secondary">Read-only view. Only HOD and admin accounts can edit the timetable.</div>
{% endif %}

<section class="panel mb-4">
  <div class="panel-heading"><div><h2>Weekly summary</h2><p>College hours and breaks for every day. Choose "Open" to see a day's timeline.</p></div></div>
  <div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Day</th><th>College hours</th><th>Breaks</th><th>Class time</th><th></th></tr></thead>
    <tbody>
    {% for row in week_summary %}
    <tr{% if row.day_num == selected_day %} class="table-active"{% endif %}>
      <td><strong>{{ row.day_name }}</strong>{% if row.is_today %} <span class="badge text-bg-primary">Today</span>{% endif %}</td>
      <td>{{ row.range_label }}</td>
      <td>{% if row.break_count %}{{ row.breaks|join(' • ') }}{% else %}{{ '—' if row.has_timetable else '' }}{% endif %}</td>
      <td>{{ row.class_label }}</td>
      <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ url_for('admin.schedule', day=row.day_num, _anchor='timeline') }}">Open</a></td>
    </tr>
    {% endfor %}
    </tbody>
  </table></div>
</section>

<section class="panel"><div class="panel-heading"><div><h2>Holiday and exam exceptions</h2><p>Date-specific overrides stay separate from the weekly timetable.</p></div></div>
{% if can_edit %}<form method="post" action="{{ url_for('admin.schedule') }}" class="border rounded-3 p-3 mb-3"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="action" value="exception_add"><div class="row g-2 align-items-end"><div class="col-md-3"><label class="form-label">Date</label><input class="form-control" type="date" name="on_date" required></div><div class="col-md-3"><label class="form-label">Mode</label><select class="form-select" name="mode" required><option value="unrestricted">Unrestricted (holiday)</option><option value="restricted">Restricted (exam)</option></select></div><div class="col-md-4"><label class="form-label">Note</label><input class="form-control" name="note" maxlength="150" placeholder="Holiday or exam name"></div><div class="col-md-2"><button class="btn btn-outline-primary w-100" type="submit">Add exception</button></div></div></form>{% endif %}
<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Date</th><th>Mode</th><th>Note</th>{% if can_edit %}<th>Actions</th>{% endif %}</tr></thead><tbody>
{% for e in exceptions %}<tr><td>{{ e.on_date|date_display }}</td><td>{{ e.mode|title }}</td><td>{{ e.note or '—' }}</td>{% if can_edit %}<td>
<form method="post" action="{{ url_for('admin.schedule') }}" class="d-flex flex-wrap gap-2 align-items-center"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="action" value="exception_edit"><input type="hidden" name="exception_id" value="{{ e.exception_id }}"><input class="form-control form-control-sm" style="max-width:145px" type="date" name="on_date" value="{{ e.on_date.isoformat() if e.on_date.isoformat is defined else e.on_date }}" required><select class="form-select form-select-sm" style="max-width:150px" name="mode"><option value="unrestricted" {% if e.mode=='unrestricted' %}selected{% endif %}>Unrestricted</option><option value="restricted" {% if e.mode=='restricted' %}selected{% endif %}>Restricted</option></select><input class="form-control form-control-sm" style="max-width:170px" name="note" maxlength="150" value="{{ e.note or '' }}" aria-label="Exception note"><button class="btn btn-sm btn-outline-primary" type="submit">Update</button></form>
<form method="post" action="{{ url_for('admin.schedule') }}" class="mt-2"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="action" value="exception_delete"><input type="hidden" name="exception_id" value="{{ e.exception_id }}"><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form>
</td>{% endif %}</tr>{% else %}<tr><td colspan="{{ 4 if can_edit else 3 }}" class="text-muted">No holiday or exam exceptions configured.</td></tr>{% endfor %}
</tbody></table></div></section>
{% endif %}
{% endblock %}
