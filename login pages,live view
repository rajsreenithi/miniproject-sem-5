  @media print { .sidebar, .topbar, .page-footer, .report-controls, .nav-tabs, .btn, .flash-stack { display: none !important; } .main-area, .content-area { margin: 0 !important; padding: 0 !important; } .tab-pane { display: block !important; opacity: 1 !important; } .tab-pane:not(.active) { display: block !important; } .card { break-inside: avoid; box-shadow: none !important; } }
</style>
