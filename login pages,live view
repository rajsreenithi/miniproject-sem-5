">Minimum people needed to trigger evaluation.</div></div><div class="rule-field"><label class="form-label" for="duration{{ rule.rule_id }}">Minimum duration (sec)</label><input id="duration{{ rule.rule_id }}" class="form-control" type="number" name="min_duration_sec" min="0" max="2147483647" value="{{ rule.min_duration_sec }}" required><div class="form-text">How long the condition must persist.</div></div><div class="rule-field"><label class="form-label" for="clear{{ rule.rule_id }}">Clear after (sec)</label><input id="clear{{ rule.rule_id }}" class="form-control" type="number" name="clear_after_sec" min="0" max="2147483647" value="{{ rule.clear_after_sec }}" required><div class="form-text">Clear condition after this period.</div></div><div class="rule-field"><label class="form-label" for="cooldown{{ rule.rule_id }}">Cooldown (sec)</label><input id="cooldown{{ rule.rule_id }}" class="form-control" type="number" name="cooldown_sec" min="0" max="2147483647" value="{{ rule.cooldown_sec }}" required><div class="form-text">Wait time before a repeat alert.</div></div></div><div class="rule-card-footer"><label class="form-check form-switch"><input class="form-check-input" type="checkbox" name="is_active" value="1" {% if rule.is_active %}checked{% endif %}><span class="form-check-label">Rule enabled</span></label><button class="btn btn-primary">Save rule</button></div></form></section>{% endfor %}</div>{% endif %}{% endblock %}
