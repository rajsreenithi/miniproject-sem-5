{% extends "base.html" %}
{% block head %}<meta http-equiv="refresh" content="5">{% endblock %}

{% block content %}
<div class="container-fluid py-3">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <h2 class="mb-1">Live cameras</h2>
      <p class="text-muted mb-0">Latest processed camera frame</p>
    </div>
    <form method="get" action="{{ url_for('dashboard_pages.live') }}" class="d-flex gap-2">
      <select name="camera_id" class="form-select" aria-label="Select camera" {% if not cameras %}disabled{% endif %}>
        {% for item in cameras %}
          <option value="{{ item.camera_id }}"
                  {% if camera and item.camera_id == camera.camera_id %}selected{% endif %}>
            {{ item.name }}{% if item.floor_label %} — {{ item.floor_label }}{% endif %}
          </option>
        {% endfor %}
      </select>
      <button class="btn btn-primary" type="submit" {% if not cameras %}disabled{% endif %}>View</button>
    </form>
  </div>

  <div class="card shadow-sm">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
      <h5 class="mb-0">{{ camera.name if camera else "No camera selected" }}</h5>
      {% if camera %}
        {% if camera.is_active %}
          <span class="badge bg-success">Enabled</span>
        {% else %}
          <span class="badge bg-secondary">Disabled</span>
        {% endif %}
      {% endif %}
    </div>
    <div class="card-body">
      {% if not camera %}
        <div class="text-center text-muted py-5">
          <h5>No cameras configured</h5>
          <p class="mb-0">Add a camera for this site to view its frames.</p>
        </div>
      {% elif image_exists %}
        <img class="img-fluid rounded border w-100"
     src="{{ url_for('dashboard_pages.live_frame', camera_id=camera.camera_id) }}"
     alt="Latest frame from {{ camera.name }}">
        <div class="d-flex justify-content-between flex-wrap gap-2 mt-3">
          <span class="text-muted small">Frame file: camera_{{ camera.camera_id }}.jpg</span>
          <a class="btn btn-outline-primary btn-sm"
             href="{{ url_for('dashboard_pages.live_snapshot', camera_id=camera.camera_id) }}">
            Download snapshot
          </a>
        </div>
      {% else %}
        <div class="text-center text-muted py-5">
          <h5>Camera frame unavailable</h5>
          <p class="mb-0">Start the worker and check that it writes the latest frame to <code>data/live/</code>.</p>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
