{% block content %}
<div class="container-fluid py-3 report-page">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
      <h2 class="mb-1">Reports</h2>
      <p class="text-muted mb-0">PDF is the primary report output{% if site %} • {{ site.name }}{% endif %}</p>
    </div>
    <div class="d-flex flex-wrap gap-2 report-controls">
      <a class="btn btn-primary" href="{{ url_for('dashboard_pages.report_pdf', **{'from': start_value, 'to': end_value}) }}">Download PDF</a>
      <a class="btn btn-outline-primary" href="{{ url_for('dashboard_pages.export_report_csv', **{'from': start_value, 'to': end_value}) }}">Export data (CSV)</a>
      <a class="btn btn-outline-secondary" target="_blank" rel="noopener" href="{{ url_for('dashboard_pages.print_report', **{'from': start_value, 'to': end_value}) }}">Print</a>
    </div>
  </div>

  <div class="card shadow-sm mb-4 report-controls">
    <div class="card-body">
      <form method="get" action="{{ url_for('dashboard_pages.reports') }}">
        <div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="Quick report ranges">
          <button class="btn {{ 'btn-primary' if preset == 'today' else 'btn-outline-primary' }}" name="range" value="today" type="submit">Today</button>
          <button class="btn {{ 'btn-primary' if preset == 'yesterday' else 'btn-outline-primary' }}" name="range" value="yesterday" type="submit">Yesterday</button>
          <button class="btn {{ 'btn-primary' if preset == 'last7' else 'btn-outline-primary' }}" name="range" value="last7" type="submit">Last 7 days</button>
        </div>
        <div class="row g-3 align-items-end">
          <div class="col-12 col-md-4">
            <label class="form-label" for="from-date">From</label>
            <input class="form-control" id="from-date" type="date" name="from" value="{{ start_value }}" required>
          </div>
          <div class="col-12 col-md-4">
            <label class="form-label" for="to-date">To</label>
            <input class="form-control" id="to-date" type="date" name="to" value="{{ end_value }}" required>
          </div>
          <div class="col-12 col-md-4">
            <button class="btn btn-dark" type="submit" name="range" value="custom">Apply custom range</button>
          </div>
        </div>
      </form>
      {% if date_error %}<div class="alert alert-danger mt-3 mb-0">{{ date_error }}</div>{% endif %}
    </div>
  </div>

  {% if not site %}
    <div class="alert alert-warning">Select a site to preview or download a report.</div>
  {% else %}
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
      <div><h4 class="mb-1">{{ site.name }}</h4><div class="text-muted small">{{ start_date.strftime('%d %b %Y') }} – {{ end_date.strftime('%d %b %Y') }} • {{ site.site_type|replace('_', ' ')|title }}</div></div>
      <span class="badge text-bg-light border">{{ report.incident_count }} incidents</span>
    </div>

    <ul class="nav nav-tabs report-controls" id="reportTabs" role="tablist">
      <li class="nav-item" role="presentation"><button class="nav-link active" id="summary-tab" data-bs-toggle="tab" data-bs-target="#summary-panel" type="button" role="tab" aria-controls="summary-panel" aria-selected="true">Summary</button></li>
      <li class="nav-item" role="presentation"><button class="nav-link" id="incidents-tab" data-bs-toggle="tab" data-bs-target="#incidents-panel" type="button" role="tab" aria-controls="incidents-panel" aria-selected="false">Incidents</button></li>
      <li class="nav-item" role="presentation"><button class="nav-link" id="charts-tab" data-bs-toggle="tab" data-bs-target="#charts-panel" type="button" role="tab" aria-controls="charts-panel" aria-selected="false">Charts</button></li>
    </ul>

    <div class="tab-content border border-top-0 bg-white rounded-bottom p-3 p-lg-4" id="reportTabContent">
      <section class="tab-pane fade show active" id="summary-panel" role="tabpanel" aria-labelledby="summary-tab" tabindex="0">
        <h5 class="mb-3">Plain-language summary</h5>
        <div class="report-summary mb-4">
          {% for sentence in report.summary_sentences %}<p class="mb-2">{{ sentence }}</p>{% endfor %}
        </div>
        <div class="row g-3">
          {% if site.site_type == 'water_point' %}
            <div class="col-6 col-xl"><div class="report-kpi"><div class="label">Violations</div><div class="value">{{ report.violations }}</div></div></div>
            <div class="col-6 col-xl"><div class="report-kpi"><div class="label">Violation minutes</div><div class="value">{{ (report.violation_seconds / 60)|round(1) }}</div></div></div>
            <div class="col-6 col-xl"><div class="report-kpi"><div class="label">Longest gathering</div><div class="value">{{ report.longest_seconds|duration }}</div></div></div>
            <div class="col-6 col-xl"><div class="report-kpi"><div class="label">Peak count</div><div class="value">{{ report.peak_count }}</div></div></div>
            <div class="col-6 col-xl"><div class="report-kpi"><div class="label">Class-time compliance</div><div class="value">{{ ('%.1f%%'|format(report.compliance_pct)) if report.compliance_pct is not none else 'N/A' }}</div></div></div>
          {% else %}
            <div class="col-6 col-xl"><div class="report-kpi"><div class="label">Entries</div><div class="value">{{ report.entries }}</div></div></div>
            <div class="col-6 col-xl"><div class="report-kpi"><div class="label">Exits</div><div class="value">{{ report.exits }}</div></div></div>
            <div class="col-6 col-xl"><div class="report-kpi"><div class="label">Average dwell</div><div class="value">{{ report.average_dwell_sec|duration }}</div></div></div>
            <div class="col-6 col-xl"><div class="report-kpi"><div class="label">Busiest hour</div><div class="value">{{ ('%02d:00'|format(report.busiest_hour)) if report.busiest_hour is not none else '—' }}</div></div></div>
            <div class="col-6 col-xl"><div class="report-kpi"><div class="label">Incidents</div><div class="value">{{ report.incident_count }}</div></div></div>
          {% endif %}
        </div>
        <p class="text-muted small mt-4 mb-0">Generated {{ report.generated_at.strftime('%d %b %Y, %H:%M:%S') }}. AuraVision stores counts and timings only, never faces or identities.</p>
      </section>

      <section class="tab-pane fade" id="incidents-panel" role="tabpanel" aria-labelledby="incidents-tab" tabindex="0">
        <div class="d-flex justify-content-between align-items-center mb-3"><h5 class="mb-0">Incident history</h5><span class="text-muted small">{{ report.incidents|length }} rows</span></div>
        <div class="table-responsive">
          <table class="table table-striped table-hover align-middle">
            <thead><tr><th>Start</th><th>End</th><th>Duration</th><th>Peak</th><th>Floor</th><th>Alert status</th></tr></thead>
            <tbody>
              {% for item in report.incidents %}
              <tr>
                <td>{{ item.started_at|datetime_display }}</td><td>{{ item.ended_at|datetime_display if item.ended_at else 'Open' }}</td>
                <td>{{ item.duration_human }}</td><td>{{ item.peak_count }}</td><td>{{ item.floor_label or item.camera_name or '—' }}</td><td>{{ item.alert_status or 'No alerts' }}</td>
              </tr>
              {% else %}<tr><td colspan="6" class="text-center text-muted py-4">No incidents recorded for this period.</td></tr>{% endfor %}
            </tbody>
          </table>
        </div>
      </section>

      <section class="tab-pane fade" id="charts-panel" role="tabpanel" aria-labelledby="charts-tab" tabindex="0">
        <h5>Hourly activity</h5>
        <img class="report-chart" src="{{ url_for('dashboard_pages.report_chart', chart='hourly', **{'from': start_value, 'to': end_value}) }}" alt="Hourly activity chart">
        <h5>Incidents by time slot or weekday</h5>
        <img class="report-chart" src="{{ url_for('dashboard_pages.report_chart', chart='incidents', **{'from': start_value, 'to': end_value}) }}" alt="Incidents by time slot or weekday chart">
        {% if report.heatmap_path %}<p class="text-muted small">Heatmap source: camera image last updated {{ report.heatmap_date.strftime('%d %b %Y, %H:%M') if report.heatmap_date else 'date unavailable' }}. The PDF includes the available heatmap and a low-to-high legend.</p>{% else %}<p class="text-muted small">No saved camera heatmap is available for this site; the PDF will omit that section.</p>{% endif %}
      </section>
    </div>
  {% endif %}
</div>
{% endblock %}
