{% extends "base.html" %}

{% block content %}
<div class="container-fluid py-3">
  <div class="mb-4">
    <h2 class="mb-1">Incidents</h2>
    <p class="text-muted mb-0">Review rule incidents and alert delivery counts.</p>
  </div>

  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <form method="get" class="row g-3 align-items-end">
        <div class="col-12 col-md-3">
          <label class="form-label" for="start">From date</label>
          <input class="form-control" id="start" type="date" name="start" value="{{ start_value }}">
        </div>
        <div class="col-12 col-md-3">
          <label class="form-label" for="end">To date</label>
          <input class="form-control" id="end" type="date" name="end" value="{{ end_value }}">
        </div>
        <div class="col-12 col-md-3">
          <label class="form-label" for="status">Status</label>
          <select class="form-select" id="status" name="status">
            <option value="">All statuses</option>
            <option value="open" {% if status == "open" %}selected{% endif %}>Open</option>
            <option value="closed" {% if status == "closed" %}selected{% endif %}>Closed</option>
          </select>
        </div>
        <div class="col-12 col-md-3 d-flex gap-2">
          <button class="btn btn-primary" type="submit">Apply filters</button>
          <a class="btn btn-outline-secondary" href="{{ url_for('dashboard_pages.incidents') }}">Reset</a>
        </div>
      </form>
    </div>
  </div>

  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white"><h5 class="mb-0">Incident history</h5></div>
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>ID</th><th>Started</th><th>Camera / floor</th><th>Rule</th>
            <th>Peak</th><th>Duration (sec)</th><th>Status</th><th>Alerts</th><th>Details</th>
          </tr>
        </thead>
        <tbody>
          {% for item in incidents %}
            <tr>
              <td>{{ item.incident_id }}</td>
              <td>{{ item.started_at|datetime_display }}</td>
              <td>
                {{ item.camera_name }}
                {% if item.floor_label %}<div class="small text-muted">{{ item.floor_label }}</div>{% endif %}
              </td>
              <td>{{ item.rule_type|replace("_", " ")|title }}</td>
              <td>{{ item.peak_count }}</td>
              <td>{{ item.duration_sec if item.duration_sec is not none else "—" }}</td>
              <td>
                {% if item.status == "open" %}
                  <span class="badge bg-danger">Open</span>
                {% else %}
                  <span class="badge bg-success">Closed</span>
                {% endif %}
              </td>
              <td>{{ item.alert_count }}</td>
              <td>
                <button class="btn btn-sm btn-outline-primary" type="button"
                        data-bs-toggle="modal"
                        data-bs-target="#incident-{{ item.incident_id }}">
                  Details
                </button>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="9" class="text-center text-muted py-5">
                No incidents match these filters.
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  {% for item in incidents %}
    <div class="modal fade" id="incident-{{ item.incident_id }}" tabindex="-1"
         aria-labelledby="incident-label-{{ item.incident_id }}" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="incident-label-{{ item.incident_id }}">
              Incident #{{ item.incident_id }}
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <dl class="row mb-0">
              <dt class="col-5">Camera</dt><dd class="col-7">{{ item.camera_name }}</dd>
              <dt class="col-5">Floor</dt><dd class="col-7">{{ item.floor_label or "—" }}</dd>
              <dt class="col-5">Rule</dt><dd class="col-7">{{ item.rule_type|replace("_", " ")|title }}</dd>
              <dt class="col-5">Started</dt><dd class="col-7">{{ item.started_at|datetime_display }}</dd>
              <dt class="col-5">Ended</dt><dd class="col-7">{{ item.ended_at|datetime_display if item.ended_at else "Still open" }}</dd>
              <dt class="col-5">Duration</dt><dd class="col-7">{{ item.duration_sec if item.duration_sec is not none else "—" }} seconds</dd>
              <dt class="col-5">Peak count</dt><dd class="col-7">{{ item.peak_count }}</dd>
              <dt class="col-5">Incident status</dt><dd class="col-7">{{ item.status|title }}</dd>
              <dt class="col-5">Alert records</dt><dd class="col-7">{{ item.alert_count }}</dd>
            </dl>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>
  {% endfor %}

  <div class="card shadow-sm">
    <div class="card-header bg-white"><h5 class="mb-0">Busiest incident hours</h5></div>
    <div class="card-body">
      {% if worst_hours %}
        {% for item in worst_hours %}
          <div class="mb-3">
            <div class="d-flex justify-content-between mb-1">
              <span>{{ "%02d"|format(item.hour) }}:00–{{ "%02d"|format((item.hour + 1) % 24) }}:00</span>
              <strong>{{ item.total }}</strong>
            </div>
            <div class="progress" style="height: 8px;">
              <div class="progress-bar bg-warning"
                   style="width: {{ ((item.total / max_worst) * 100)|int if max_worst else 0 }}%"></div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="text-center text-muted py-4">No incident activity for this date range.</div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
